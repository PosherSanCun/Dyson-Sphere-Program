# 白名单：共享蓝图、手动存档、指定的自制模组及仓库说明。
# 个人配置、账号文件、成就、元数据和 Steam Cloud 文件默认不入库。
*
!/.gitignore
!/.gitattributes
!/README.md

!/Blueprint/
!/Blueprint/**/
!/Blueprint/**/*.txt
!/Blueprints/
!/Blueprints/**/
!/Blueprints/**/*.txt

!/Save/
!/Save/**/
!/Save/**/*.dsv
!/Save/**/*.server

# 收纳模组：仅分发本模组的代码、说明、安装工具和发布产物。
!/Mods/
!/Mods/QuickLogisticsStore/
!/Mods/QuickLogisticsStore/README.md
!/Mods/QuickLogisticsStore/manifest.json
!/Mods/QuickLogisticsStore/build.ps1
!/Mods/QuickLogisticsStore/Install.ps1
!/Mods/QuickLogisticsStore/src/
!/Mods/QuickLogisticsStore/src/*.cs
!/Mods/QuickLogisticsStore/tests/
!/Mods/QuickLogisticsStore/tests/NativeStorageChecks.ps1
!/Mods/QuickLogisticsStore/dist/
!/Mods/QuickLogisticsStore/dist/QuickLogisticsStore.dll
!/Mods/QuickLogisticsStore/dist/QuickLogisticsStore.dll.sha256
!/Mods/QuickLogisticsStore/dist/SanCun-QuickLogisticsStore-*.zip

# 自动存档和退出存档频繁变化；共享进度请使用有名称的手动存档。
/Save/**/_autosave_*.dsv
/Save/**/_autosave_*.server
/Save/**/_lastexit_.dsv
/Save/**/_lastexit_.server
